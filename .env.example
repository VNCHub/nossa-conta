# Banco (usado pelo docker-compose e pelo Prisma)
POSTGRES_USER=nossa_conta
POSTGRES_PASSWORD=nossa_conta_dev
POSTGRES_DB=nossa_conta
# Porta exposta no host (o container sempre usa 5432 internamente)
POSTGRES_PORT=5433
# Rodando fora do Docker (prisma migrate, seed, testes) use localhost:5433.
# Dentro do compose, o serviço backend recebe db:5432 por variável de ambiente.
DATABASE_URL=postgresql://nossa_conta:nossa_conta_dev@localhost:5433/nossa_conta?schema=public
# Usada só pelo `prisma migrate` — em dev é igual a DATABASE_URL (sem pooler).
# Em produção (Neon) precisa ser a conexão direta, sem "-pooler" no host: um
# pooler pode trocar a conexão física em uso durante uma sessão, e o advisory
# lock do migrate não sobrevive a isso (erro P1002).
DIRECT_URL=postgresql://nossa_conta:nossa_conta_dev@localhost:5433/nossa_conta?schema=public

# Auth — troque em produção por valores longos e aleatórios
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Rede
PORT=3000
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000

# Importação de extratos bancários
IMPORT_STORAGE_DIR=./storage/imports
# Dias até o arquivo importado ser excluído (a exclusão em si é um débito técnico, ver AGENTS.md)
IMPORT_RETENTION_DAYS=7
IMPORT_MAX_FILE_SIZE_MB=5
IMPORT_MAX_FILES_PER_REQUEST=10

# E-mail de redefinição de senha — Brevo (API HTTP, sem domínio verificado).
# BREVO_API_KEY vem de app.brevo.com/settings/keys/api.
# BREVO_FROM_EMAIL precisa estar verificado como sender (app.brevo.com/senders).
BREVO_API_KEY=
BREVO_FROM_EMAIL=
# URL do front em produção — usada para montar o link do e-mail de reset.
FRONTEND_URL=http://localhost:5173
