generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IncomeType {
  RECURRING
  ONE_OFF
}

enum ExpenseType {
  FIXED
  OPTIONAL
  ONE_OFF
}

enum RuleType {
  EQUAL
  INCOME
  SURPLUS
  FIXED
  METER
}

enum BankProvider {
  NUBANK
  /// Not a real bank — this app's own "Exportar dados" file, re-imported elsewhere.
  INTERNAL
}

enum ImportDocumentType {
  ACCOUNT_STATEMENT
  INVOICE
  INTERNAL_EXPORT
}

enum ImportFileFormat {
  CSV
  OFX
  JSON
}

/// Where a record came from — kept even if the ImportedFile it points to is
/// later purged, so provenance never disappears with the file.
enum RecordSource {
  MANUAL
  IMPORT
}

enum RoleName {
  DEFAULT
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  color        String
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  familyId String?
  family   Family? @relation("FamilyMembers", fields: [familyId], references: [id], onDelete: SetNull)

  createdFamilies  Family[]         @relation("FamilyCreator")
  incomes          Income[]
  expenses         Expense[]
  expenseShares    ExpenseShare[]
  ruleWeights      RuleWeight[]
  ruleMeasurements RuleMeasurement[]
  importedFiles    ImportedFile[]
  roles            UserRole[]
  passwordResetTokens PasswordResetToken[]

  @@index([familyId])
}

/// Single-use, short-lived token for the "forgot password" flow. Stores the
/// hash, never the token itself — the same reasoning as passwordHash: a
/// database leak should not hand out working reset links.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Platform-wide roles — not scoped to a family. Today only "admin" gates
/// anything (the administrative panel); every other user has just "default".
model Role {
  id        String   @id @default(cuid())
  name      RoleName @unique
  createdAt DateTime @default(now())

  userRoles UserRole[]
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

enum ErrorSource {
  FRONTEND
  BACKEND
}

/// One row per group of similar errors — what the observability list shows.
/// Never holds a stack trace; that only lives on ErrorEvent.
model ErrorIssue {
  id          String      @id @default(cuid())
  source      ErrorSource
  fingerprint String      @unique
  title       String
  firstSeenAt DateTime    @default(now())
  lastSeenAt  DateTime    @default(now())
  eventsCount Int         @default(0)

  events ErrorEvent[]

  @@index([source, lastSeenAt])
}

/// One row per occurrence of an ErrorIssue — the raw title/stack the issues list never shows.
model ErrorEvent {
  id         String   @id @default(cuid())
  title      String
  stack      String   @db.Text
  occurredAt DateTime @default(now())

  issueId String
  issue   ErrorIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, occurredAt])
}

model Family {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  createdById String
  createdBy   User   @relation("FamilyCreator", fields: [createdById], references: [id])

  members       User[]         @relation("FamilyMembers")
  expenses      Expense[]
  rules         SplitRule[]
  importedFiles ImportedFile[]
}

model Income {
  id          String     @id @default(cuid())
  type        IncomeType
  description String
  amount      Decimal    @db.Decimal(12, 2)
  /// filled when type = RECURRING
  dayOfMonth  Int?
  /// filled when type = ONE_OFF
  date        DateTime?    @db.Date
  /// permanent, unlike importedFileId — survives the file being purged
  source      RecordSource @default(MANUAL)
  createdAt   DateTime     @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  importedFileId String?
  importedFile   ImportedFile? @relation(fields: [importedFileId], references: [id], onDelete: SetNull)
  /// dedup key for imported rows — lets a re-imported, still-incomplete
  /// statement skip transactions an earlier file already brought in. Null for
  /// manual entries; Postgres allows any number of nulls in a unique index.
  importKey      String?

  @@unique([userId, importKey])
  @@index([userId])
}

model Expense {
  id            String      @id @default(cuid())
  date          DateTime    @db.Date
  /// YYYY-MM period, derived from `date` — avoids a range scan on every report
  month         String      @db.VarChar(7)
  /// null fields mean the expense was logged incomplete and still needs action
  paymentMethod String?
  category      String?
  expenseType   ExpenseType?
  description   String      @default("")
  amount        Decimal?     @db.Decimal(12, 2)
  shared        Boolean      @default(false)
  /// permanent, unlike importedFileId — survives the file being purged
  source        RecordSource @default(MANUAL)
  createdAt     DateTime     @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// denormalized on purpose: freezes history if the user changes family
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  ruleId String?
  rule   SplitRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  importedFileId String?
  importedFile   ImportedFile? @relation(fields: [importedFileId], references: [id], onDelete: SetNull)
  /// dedup key for imported rows — see Income.importKey
  importKey      String?

  shares ExpenseShare[]

  @@unique([familyId, importKey])
  @@index([familyId, month])
  @@index([userId, month])
}

model ExpenseShare {
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([expenseId, userId])
  @@index([userId])
}

model SplitRule {
  id          String   @id @default(cuid())
  name        String
  type        RuleType
  description String
  /// only for type = METER (e.g. "km")
  unit        String?
  createdAt   DateTime @default(now())

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  weights      RuleWeight[]
  measurements RuleMeasurement[]
  expenses     Expense[]

  @@index([familyId])
}

/// Percentages agreed once — type = FIXED
model RuleWeight {
  ruleId String
  rule   SplitRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  percent Decimal @db.Decimal(6, 2)

  @@id([ruleId, userId])
}

/// Measurement entered month by month — type = METER
model RuleMeasurement {
  ruleId String
  rule   SplitRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  month  String  @db.VarChar(7)
  amount Decimal @db.Decimal(12, 2)

  @@id([ruleId, userId, month])
  @@index([ruleId, month])
}

/// History of a bank statement import — one row per file, created only when
/// the whole file is processed successfully (see ImportsService).
model ImportedFile {
  id           String             @id @default(cuid())
  bank         BankProvider
  documentType ImportDocumentType
  fileFormat   ImportFileFormat
  originalName String
  storagePath  String
  /// sha256 of the raw upload — dedup key, scoped to the family
  fingerprint  String
  sizeBytes    Int
  /// oldest / newest transaction date found in the file (its coverage)
  periodStart  DateTime  @db.Date
  periodEnd    DateTime  @db.Date
  /// transactions in this file that matched an importKey already saved by an
  /// earlier import — a re-exported, previously-incomplete statement often
  /// overlaps like this instead of being byte-identical
  duplicateTransactionsSkipped Int @default(0)
  /// createdAt + IMPORT_RETENTION_DAYS — read by the (future) cleanup task
  expiresAt    DateTime
  /// set once the cleanup task deletes the physical file
  purgedAt     DateTime?
  createdAt    DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// denormalized like Expense.familyId: freezes history if the user changes family
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  expenses Expense[]
  incomes  Income[]

  @@unique([familyId, fingerprint])
  @@index([familyId, createdAt])
}
