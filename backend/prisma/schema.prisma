generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IncomeType {
  RECURRING
  ONE_OFF
}

enum ExpenseType {
  FIXED
  OPTIONAL
}

enum RuleType {
  EQUAL
  INCOME
  SURPLUS
  FIXED
  METER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  color        String
  createdAt    DateTime @default(now())

  familyId String?
  family   Family? @relation("FamilyMembers", fields: [familyId], references: [id], onDelete: SetNull)

  createdFamilies  Family[]         @relation("FamilyCreator")
  incomes          Income[]
  expenses         Expense[]
  expenseShares    ExpenseShare[]
  ruleWeights      RuleWeight[]
  ruleMeasurements RuleMeasurement[]

  @@index([familyId])
}

model Family {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  createdById String
  createdBy   User   @relation("FamilyCreator", fields: [createdById], references: [id])

  members  User[]      @relation("FamilyMembers")
  expenses Expense[]
  rules    SplitRule[]
}

model Income {
  id          String     @id @default(cuid())
  type        IncomeType
  description String
  amount      Decimal    @db.Decimal(12, 2)
  /// filled when type = RECURRING
  dayOfMonth  Int?
  /// filled when type = ONE_OFF
  date        DateTime?  @db.Date
  createdAt   DateTime   @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Expense {
  id            String      @id @default(cuid())
  date          DateTime    @db.Date
  /// YYYY-MM period, derived from `date` — avoids a range scan on every report
  month         String      @db.VarChar(7)
  paymentMethod String
  category      String
  expenseType   ExpenseType
  description   String
  amount        Decimal     @db.Decimal(12, 2)
  shared        Boolean     @default(false)
  createdAt     DateTime    @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// denormalized on purpose: freezes history if the user changes family
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  ruleId String?
  rule   SplitRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  shares ExpenseShare[]

  @@index([familyId, month])
  @@index([userId, month])
}

model ExpenseShare {
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([expenseId, userId])
  @@index([userId])
}

model SplitRule {
  id          String   @id @default(cuid())
  name        String
  type        RuleType
  description String
  /// only for type = METER (e.g. "km")
  unit        String?
  createdAt   DateTime @default(now())

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  weights      RuleWeight[]
  measurements RuleMeasurement[]
  expenses     Expense[]

  @@index([familyId])
}

/// Percentages agreed once — type = FIXED
model RuleWeight {
  ruleId String
  rule   SplitRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  percent Decimal @db.Decimal(6, 2)

  @@id([ruleId, userId])
}

/// Measurement entered month by month — type = METER
model RuleMeasurement {
  ruleId String
  rule   SplitRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  month  String  @db.VarChar(7)
  amount Decimal @db.Decimal(12, 2)

  @@id([ruleId, userId, month])
  @@index([ruleId, month])
}
