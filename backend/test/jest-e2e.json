{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": { "^.+\\.(t|j)s$": "ts-jest" },
  "moduleNameMapper": {
    "^@shared/(.*)$": "<rootDir>/../shared/src/$1",
    "^@shared$": "<rootDir>/../shared/src/index.ts"
  }
}
